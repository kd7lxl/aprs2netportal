# Configuration for docker compose. Copy to .env, fill in, chmod 600.
# See deploy/README.md.

### Required

# Django secret key. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=

# Password of the "portal" database role. Used when the database is first
# created; changing it later takes an ALTER ROLE as well.
POSTGRES_PASSWORD=

# Host names the portal is served as, comma separated.
ALLOWED_HOSTS=t2sysop.aprs2.net
CSRF_TRUSTED_ORIGINS=https://t2sysop.aprs2.net

# Set to 1 when a reverse proxy terminates TLS and sets X-Forwarded-Proto.
# Makes session cookies HTTPS-only.
BEHIND_TLS_PROXY=1

# With BEHIND_TLS_PROXY=1 the portal sends Strict-Transport-Security, which
# makes browsers refuse plain HTTP for this host name for this many seconds
# (default: one year). Use a small value, such as 300, while trying out a new
# installation; 0 turns it off.
#HSTS_SECONDS=31536000

### Web

# Address and port the application listens on, on the Docker host.
# Keep it on localhost; the reverse proxy connects here.
#WEB_BIND=127.0.0.1:8000

#GUNICORN_WORKERS=2
#GUNICORN_THREADS=4
#TIME_ZONE=UTC

# Login with ARRL Logbook of The World client certificates. Requires the
# reverse proxy configuration described in deploy/README.md. Do NOT enable
# without it.
# A certificate logs in the existing user whose username is its callsign;
# it never creates a user.
#LOTW_CLIENT_CERT_AUTH=1

### Email (password reset messages, error reports)

# Without EMAIL_HOST, mail is only printed to the container log.
# For a mail server on the Docker host itself, use host.docker.internal
# (not 127.0.0.1, which is the container) and see "Outbound email" in
# deploy/README.md for what the mail server and the firewall need.
#EMAIL_HOST=smtp.example.net
#EMAIL_PORT=25
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=0
#DEFAULT_FROM_EMAIL=t2sysop@aprs2.net
#SERVER_EMAIL=t2sysop@aprs2.net
# Recipients of error reports, comma separated.
#ADMINS=

### PostgreSQL

# Major version of PostgreSQL. Changing this is a major upgrade and needs the
# procedure in deploy/README.md; it is not enough to edit the number.
#POSTGRES_VERSION=18

# How much write-ahead log the server keeps for pghoard to catch up from
# after an outage, and how often (seconds) it finishes a WAL segment so that
# pghoard can upload it. See "Backups" in deploy/README.md.
#POSTGRES_WAL_KEEP_SIZE=4GB
#POSTGRES_ARCHIVE_TIMEOUT=600

### Backups to AWS S3 with pghoard

# Uncomment to run the pghoard service.
#COMPOSE_PROFILES=backup

# Password of the "pghoard" replication role in the database.
#PGHOARD_DB_PASSWORD=

#PGHOARD_S3_BUCKET=
#PGHOARD_S3_REGION=eu-north-1
#PGHOARD_S3_ACCESS_KEY_ID=
#PGHOARD_S3_SECRET_ACCESS_KEY=
# Optional key prefix inside the bucket.
#PGHOARD_S3_PREFIX=

# Backups are stored under this name. Use a new name after a major
# PostgreSQL upgrade or after restoring a backup.
#PGHOARD_SITE=t2sysop

# A full base backup is taken this often, and this many are kept, together
# with the WAL needed to restore to any moment since the oldest one.
#PGHOARD_BASEBACKUP_INTERVAL_HOURS=24
#PGHOARD_BASEBACKUP_COUNT=14

# Optional client-side encryption. Directory with public.pem (and, only when
# restoring, private.pem); see deploy/README.md.
#PGHOARD_ENCRYPTION_KEY_ID=key1
#PGHOARD_KEY_DIR=./keys
